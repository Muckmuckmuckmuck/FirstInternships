# ── Supabase ────────────────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=        # server only — never ship to the client
SUPABASE_SECRET_KEY=              # optional modern alias for the server key above
VITE_SUPABASE_URL=                # client (anon)
VITE_SUPABASE_ANON_KEY=

# ── Optional account + personalized newsletter ─────────────────────────────
# Accounts can collect explicit preferences while delivery is off. Keep the
# sending gate false until the domain, provider, test inboxes, and compliance
# checklist in docs/ACCOUNT_NEWSLETTER_SYSTEM.md are complete.
VITE_ACCOUNTS_ENABLED=false       # public UI gate; enable after the migration is verified
NEWSLETTER_ENABLED=false
NEWSLETTER_DRY_RUN=true
NEWSLETTER_CONSENT_VERSION=2026-10-07
NEWSLETTER_TOKEN_SECRET=          # at least 32 random characters; server only
NEWSLETTER_AUDIT_SALT=            # at least 16 random characters; server only
NEWSLETTER_POSTAL_ADDRESS=        # valid physical mailing address required before sending
NEWSLETTER_AUDIENCE_LIMIT=50
NEWSLETTER_MAX_MATCHES=6
NEWSLETTER_MIN_MATCH_SCORE=45
RESEND_API_KEY=                   # server only
RESEND_FROM_EMAIL=                # verified identity, e.g. FirstInternships <alerts@updates.example.com>
RESEND_WEBHOOK_SECRET=            # whsec_... from the authenticated Resend webhook
SITE_URL=https://firstinternships.com

# Account Google sign-in is configured in Supabase Auth Providers; its OAuth
# client secret belongs in Supabase, not in Vercel or any VITE_ variable.

# ── Legacy Google OAuth (quarantined outreach/Gmail code only) ──────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=              # e.g. https://firstinternships.com/api/auth-google
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=

# ── Gemini ──────────────────────────────────────────────────────────────────
GEMINI_API_KEY=                   # server only

# ── Stripe ──────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=              # $20/mo recurring price
STRIPE_TOPUP_PRICE_ID=           # $5 / 100-credit one-time price

# ── App ─────────────────────────────────────────────────────────────────────
APP_URL=https://firstinternships.com
CRON_SECRET=                      # random string; guards the newsletter cron
OAUTH_STATE_SECRET=               # optional; HMAC key for the signed Gmail-connect state (falls back to the service-role key if unset)

# ── Google AdSense ──────────────────────────────────────────────────────────
# Enable only after account/site approval, policy review, and a certified CMP
# or AdSense Privacy & messaging configuration for applicable regions.
VITE_ADSENSE_ENABLED=false
VITE_ADSENSE_CLIENT=              # e.g. ca-pub-1234567890123456
VITE_ADSENSE_SLOT_TOP=            # responsive leaderboard
VITE_ADSENSE_SLOT_IN_FEED=        # in-feed unit between class-year groups
VITE_ADSENSE_SLOT_SIDEBAR=        # desktop rectangle

# ── Audience measurement ────────────────────────────────────────────────────
# Vercel Web Analytics. Cookieless, first-party, no personal identifiers, and it
# never receives planner data. Also enable Web Analytics in the Vercel project;
# the flag alone only injects the script. Launch gate, like AdSense above.
VITE_ANALYTICS_ENABLED=false

# ── IndexNow (Bing / Yandex) ────────────────────────────────────────────────
# Opt-in. When true, a successful production build submits the sitemap URLs so
# changed pages are picked up without waiting for a crawl. The key is read from
# the <32-hex>.txt file in public/ unless INDEXNOW_KEY overrides it.
# Google ignores IndexNow — its coverage still comes from Search Console.
INDEXNOW_SUBMIT=false
INDEXNOW_KEY=
